# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data: data/raw/ stays local (download it; never commit).
# data/cleaned/ is the team's canonical dataset, so it IS committed.
# Git can't re-include a file inside an ignored folder, so ignore the
# contents of data/ (data/*) instead of the folder itself (data/).
data/*
!data/cleaned/
*.parquet
!data/cleaned/*.parquet

# Backend exports are regenerated on demand (see README "Phase 2 backend")
outputs/analysis/

# Local secrets (e.g. HF_TOKEN) never get committed
.env
.env.*

# Teammates' unpacked review packages stay local
drafts/

# Professor's phase briefs stay local (course materials; repo is public)
phases/*.pdf

# macOS
.DS_Store
